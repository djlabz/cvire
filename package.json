{
  "name": "cvire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "tsx --test src/services/pdfPageCut.test.ts src/services/atsEngine.test.ts src/services/jobMatcher.test.ts src/db/cryptoVault.test.ts",
    "verify:pdf": "node scripts/verify-pdf-text.mjs",
    "verify:ats": "tsx scripts/generate-ats-sample.tsx tmp/ats-sample.pdf && node scripts/verify-ats-pdf.mjs tmp/ats-sample.pdf && tsx scripts/verify-ats-pagination.tsx",
    "smoke:pdf": "node scripts/smoke-pdf-export.mjs",
    "test:pdf-cut": "tsx --test src/services/pdfPageCut.test.ts",
    "verify:pdf-cut": "node scripts/verify-pdf-multicolumn-cut.mjs",
    "serve:cv-board": "bash cv-content/scripts/serve-board.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.14.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "html2canvas-pro": "^2.3.2",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "pdfjs-dist": "^5.6.205",
    "playwright": "^1.62.1",
    "tsx": "^4.23.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
